{
  "name": "needlecast-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "playwright test",
    "types:official": "openapi-typescript ../backend/openapi.json -o /tmp/needlecast-openapi.d.ts",
    "setup:integrations": "npm install --no-save --package-lock=false --legacy-peer-deps echarts@6.0.0 echarts-for-react@3.0.5 openapi-typescript@7.10.1 @playwright/test@1.59.0"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "swr": "2.5.1",
    "@tailwindcss/postcss": "4.3.3",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "jsdom": "26.1.0",
    "@testing-library/react": "14.3.1",
    "@testing-library/dom": "10.4.1"
  },
  "engines": {
    "node": ">=22"
  }
}
